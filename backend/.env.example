FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# On Railway set the full JSON here instead of using a file:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Set true in production so a missing model fails the deploy
REQUIRE_MODEL=false
# Set true in production so a Firebase init failure fails the deploy
REQUIRE_FIREBASE=false
# Max jobs admitted at once (1 running + waiting); extra requests get 503
MAX_PENDING_JOBS=4
DATABASE_URL=sqlite+aiosqlite:///./neurallens.db
UPLOAD_DIR=uploads
RESULTS_DIR=results
MAX_UPLOAD_BYTES=2097152
ALLOWED_ORIGINS=["http://localhost:5173"]
DEBUG=false
