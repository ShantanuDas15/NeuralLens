{
	# Railway handles TLS at its edge; Caddy serves plain HTTP behind it.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Vite emits content-hashed files under /assets: cache them forever.
	# No SPA fallback here, so a missing asset is a real 404 and is never
	# cached as HTML under a JS/CSS URL.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Error responses (e.g. a missing asset) must never be cached.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Everything else is a client-side route (React Router): fall back to the
	# app shell, which must always be revalidated so new deploys are picked up.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
